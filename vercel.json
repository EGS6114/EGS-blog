{
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "installCommand": "",
  "framework": "hugo",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=432000, must-revalidate"
        }
      ]
    },
    {
      "source": "/**/*.css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=432000, immutable" }
      ]
    },
    {
      "source": "/**/*.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=432000, immutable" }
      ]
    },
    {
      "source": "/**/*.jpg",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=432000, immutable" }
      ]
    },
    {
      "source": "/**/*.jpeg",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=432000, immutable" }
      ]
    },
    {
      "source": "/**/*.png",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=432000, immutable" }
      ]
    },
    {
      "source": "/**/*.gif",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=432000, immutable" }
      ]
    },
    {
      "source": "/**/*.svg",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=432000, immutable" }
      ]
    },
    {
      "source": "/**/*.ico",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=432000, immutable" }
      ]
    },
    {
      "source": "/**/*.webp",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=432000, immutable" }
      ]
    },
    {
      "source": "/**/*.woff2",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=432000, immutable" }
      ]
    },
    {
      "source": "/**/*.ttf",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=432000, immutable" }
      ]
    },
    {
      "source": "/**/*.eot",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=432000, immutable" }
      ]
    }
  ]
}